# Mock data file (replaces a database)
# MOCK_DATA_PATH=app/data/mock_data.json

# Embeddings: local (sentence-transformers) or openai
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
# OPENAI_API_KEY=sk-...
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

ORCH_INDEX_DIR=./data/orchestrator

# Routing thresholds
THRESHOLD_MCP=0.20
THRESHOLD_TOOL=0.28
THRESHOLD_SUGGEST=0.40
MAX_SUGGESTED_MCPS=1
KNOWLEDGE_GUARD_ENABLED=true

# Routing improvements (measured in reports/ablation.md)
# A server named in the message ("in Notion", "#general") restricts routing to it
EXPLICIT_MENTION_ENABLED=true
THRESHOLD_TOOL_MENTIONED=0.20
# Keyword (BM25) boost added to the semantic score; 0 disables keyword search
LEXICAL_WEIGHT=0.15
# Server name (and domain) in front of each embedded tool text: off, it did not help with this model
SERVER_CONTEXT_IN_TOOL_TEXT=false
SERVER_CONTEXT_INCLUDE_DOMAIN=true
